# Copy to .env. Never commit or paste secrets into chat.
DATABASE_URL=sqlite:///./reclaim.db
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# demo is explicitly simulated; sandbox uses the actual PayPal sandbox API.
PAYMENT_MODE=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
# Workspace personas are for isolated judge walkthroughs. Supabase mode verifies JWTs.
AUTH_MODE=workspace
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
SESSION_TTL_HOURS=72
CHECKOUT_MINUTES=15
AUTO_WORKER=true
