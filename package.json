{
  "name": "reclaim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:api": "PYTHONPATH=backend .venv/bin/python -m pytest backend/tests -q",
    "test:evaluation": "PYTHONPATH=backend .venv/bin/python -m unittest discover -s evaluation/tests -q && PYTHONPATH=backend .venv/bin/python -m reclaim.evaluation --provider baseline --output artifacts/raw/ai-evaluation.json",
    "verify": "npm run build && npm run test:api && npm run test:evaluation"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
